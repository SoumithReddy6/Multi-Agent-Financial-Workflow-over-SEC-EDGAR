# Required by SEC fair-access guidance. Use your real name/company and email.
SEC_USER_AGENT="Soumith Reddy soumithreddy3003@gmail.com"

# Optional LLM providers. Offline deterministic synthesis works without keys.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Runtime choices: offline, openai, anthropic
LLM_PROVIDER="offline"
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# SEC and cache configuration
SEC_MAX_REQUESTS_PER_SECOND="8"
SEC_CACHE_DIR=".cache/sec"
VECTOR_INDEX_DIR="artifacts/vector_index"
